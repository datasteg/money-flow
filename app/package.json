{
  "name": "@money-flow/web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "tokens": "node ../design/build-tokens.mjs",
    "dev": "pnpm tokens && SITE_DIR=${SITE_DIR:-../data/site} next dev -p 3007",
    "build": "pnpm tokens && next build",
    "start": "next start -p 8080",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource-variable/libre-franklin": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/noto-serif-kr": "5.3.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "pretendard": "1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
